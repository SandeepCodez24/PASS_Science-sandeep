<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============ PROJECT COORDINATES ============ -->
    <groupId>org.pass.astra</groupId>
    <artifactId>astra</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>
    <name>Astra</name>

    <!-- ============ GLOBAL PROPERTIES ============ -->
    <properties>
        <!-- Single source of truth for the Java level (the compiler plugin reads this) -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Entry points -->
        <!-- Class that EXTENDS Application (used by javafx:run) -->
        <app.main.class>application.Main</app.main.class>
        <!-- Launcher (does NOT extend Application) used for the runnable JAR / jpackage -->
        <app.launcher.class>application.Launcher</app.launcher.class>

        <!-- Native access. Two users need it:
               * JavaFX's own graphics pipeline (module javafx.graphics under
                 javafx:run, where JavaFX sits on the module path);
               * Astra itself (ALL-UNNAMED): the File Explorer's Properties
                 entry calls Windows' ShellExecuteExW through the JDK's
                 Foreign Function API (ui.directory.DirectoryShell).
             Without it JDK 25 still runs, but prints a "restricted method"
             warning the first time Properties is used. In the fat jar every
             class is unnamed, so ALL-UNNAMED alone covers both there. -->
        <app.native.access.run>javafx.graphics,ALL-UNNAMED</app.native.access.run>
        <app.native.access.jar>ALL-UNNAMED</app.native.access.jar>

        <!-- Dependency versions -->
        <javafx.version>25</javafx.version>
        <richtextfx.version>0.11.7</richtextfx.version>
        <flowless.version>0.7.3</flowless.version>
        <pdfbox.version>3.0.8</pdfbox.version>

        <!-- Strict mode: when true, ANY compiler warning fails the build.
             Default false while the cleanup is in progress. Once the warning
             list is empty, either flip this to true here or build with:
                 mvn -Dastra.strict=true clean package                     -->
        <astra.strict>false</astra.strict>
    </properties>

    <!-- ============ DEPENDENCIES ============ -->
    <!-- Maven picks the correct win/linux/mac classifier jars automatically -->
    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Code editor -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>${richtextfx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.flowless</groupId>
            <artifactId>flowless</artifactId>
            <version>${flowless.version}</version>
        </dependency>

        <!-- PDF export from the Print window. Apache 2.0, safe to bundle in
             the shipped .exe. Pulls fontbox and commons-logging with it, both
             of which the Shade plugin folds into the fat jar. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>Astra</finalName>

        <!-- Pin every lifecycle plugin so the build behaves the same on every
             machine and with every Maven version (no silent default changes). -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <!-- 0) ENFORCER: stop early with a clear message if the machine
                    building Astra has the wrong JDK or a very old Maven,
                    instead of failing later with a confusing error. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>Astra needs JDK 25 or newer to build.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                    <message>Astra needs Maven 3.6.3 or newer.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 1) COMPILER: Java 25, every javac warning shown, optional fail-on-warning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <!-- release level comes from maven.compiler.release above -->
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <failOnWarning>${astra.strict}</failOnWarning>
                    <compilerArgs>
                        <!-- All javac lint checks: deprecation, this-escape,
                             rawtypes, unchecked, fallthrough, etc. -->
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- 2) JAVAFX PLUGIN: gives you `mvn javafx:run` -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${app.main.class}</mainClass>
                    <options>
                        <!-- See app.native.access.run above -->
                        <option>--enable-native-access=${app.native.access.run}</option>
                    </options>
                </configuration>
            </plugin>

            <!-- 3) FAT/RUNNABLE JAR: bundles deps so jpackage can wrap it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- Don't litter the project root with dependency-reduced-pom.xml -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Every JavaFX jar ships its own module-info;
                                             in a fat jar they only clash. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Replaced by the manifest built below -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Signature files from signed dependencies make a
                                             repacked jar fail at startup with
                                             "Invalid signature file digest". -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <transformers>
                                <!-- Merge META-INF/services files instead of letting one
                                     dependency's copy overwrite another's -->
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${app.launcher.class}</mainClass>
                                    <manifestEntries>
                                        <!-- Honoured by `java -jar Astra.jar`. A jpackage
                                             launcher may not read it, so also give
                                             jpackage the java-options value
                                             "enable-native-access=ALL-UNNAMED"
                                             (both written with two leading dashes;
                                             XML comments cannot contain them). -->
                                        <Enable-Native-Access>${app.native.access.jar}</Enable-Native-Access>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
