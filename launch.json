{
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Astra (Run button)",
            "request": "launch",
            "mainClass": "application.Launcher",
            "projectName": "astra",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "console": "integratedTerminal"
        },
        {
            // Same launch, but pauses on an uncaught exception without the
            // debugger detaching. Useful for JavaFX startup failures, which
            // otherwise vanish into the Application thread.
            "type": "java",
            "name": "Astra (debug, stop on uncaught)",
            "request": "launch",
            "mainClass": "application.Launcher",
            "projectName": "astra",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "console": "integratedTerminal",
            "stopOnEntry": false,
            "shortenCommandLine": "argfile"
        }
    ]
}